<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<GridPane hgap="5.0" vgap="5.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ahthek.SimpleController">
  <columnConstraints>
      <ColumnConstraints />
    <ColumnConstraints />
      <ColumnConstraints />
      <ColumnConstraints />
    <ColumnConstraints />
      <ColumnConstraints />
  </columnConstraints>
  <rowConstraints>
    <RowConstraints />
    <RowConstraints />
    <RowConstraints />
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
  </rowConstraints>
   <children>
      <ListView fx:id="inputListView" prefHeight="150.0" GridPane.columnSpan="4" GridPane.rowIndex="1" />
      <HBox alignment="CENTER_LEFT" spacing="5.0" GridPane.columnSpan="4">
         <children>
            <Label text="Select video to be processed:" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="estimateLabel" />
            <Button fx:id="addButton" mnemonicParsing="false">
               <graphic>
                  <FontIcon iconLiteral="fas-plus" />
               </graphic>
            </Button>
            <Button fx:id="removeButton" mnemonicParsing="false">
               <graphic>
                  <FontIcon iconLiteral="fas-minus" />
               </graphic>
            </Button>
            <Button fx:id="clearButton" mnemonicParsing="false">
               <graphic>
                  <FontIcon iconLiteral="fas-trash" />
               </graphic>
            </Button>
         </children>
      </HBox>
      <VBox alignment="TOP_CENTER" spacing="5.0" GridPane.columnIndex="4" GridPane.rowIndex="1">
         <children>
            <Button fx:id="moveUpButton" mnemonicParsing="false" onAction="#moveUp">
               <graphic>
                  <FontIcon iconLiteral="fas-caret-up" />
               </graphic>
            </Button>
            <Button fx:id="moveDownButton" mnemonicParsing="false" onAction="#moveDown">
               <graphic>
                  <FontIcon iconLiteral="fas-caret-down" />
               </graphic>
            </Button>
         </children>
         <padding>
            <Insets left="5.0" right="5.0" />
         </padding>
      </VBox>
      <Label text="Output video codec:" GridPane.rowIndex="2" />
      <Label text="Output audio codec:" GridPane.rowIndex="3" />
      <Label text="Output container:" GridPane.rowIndex="4" />
      <ComboBox fx:id="vcodecComboBox" prefWidth="100.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
      <ComboBox fx:id="acodecComboBox" prefWidth="100.0" GridPane.columnIndex="1" GridPane.rowIndex="3" />
      <ComboBox fx:id="containerComboBox" prefWidth="100.0" GridPane.columnIndex="1" GridPane.rowIndex="4" />
      <Label text="Horizontal video max height (0 = no change):" GridPane.columnIndex="2" GridPane.rowIndex="2" />
      <TextField fx:id="hMaxHeightTextField" alignment="CENTER_RIGHT" maxWidth="-Infinity" prefWidth="50.0" text="0" GridPane.columnIndex="3" GridPane.rowIndex="2" />
      <Label text="Action:" GridPane.rowIndex="5" />
      <Label text="Vertical video max height (0 = no change):" GridPane.columnIndex="2" GridPane.rowIndex="3" />
      <TextField fx:id="vMaxHeightTextField" alignment="CENTER_RIGHT" maxWidth="-Infinity" prefWidth="50.0" text="0" GridPane.columnIndex="3" GridPane.rowIndex="3" />
      <HBox alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="5">
         <children>
            <ComboBox fx:id="actionComboBox" maxWidth="-Infinity" prefWidth="150.0" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="startButton" mnemonicParsing="false" onAction="#startAction" text="START">
               <graphic>
                  <FontIcon iconLiteral="fas-play" />
               </graphic>
            </Button>
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</GridPane>
